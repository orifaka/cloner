# Builder Bot (BotFather — alohida SaaS bot)
BUILDER_BOT_TOKEN=123456:REPLACE_ME
BUILDER_BOT_USERNAME=YourBuilderBot

PUBLIC_BASE_URL=https://bots.yourdomain.com
API_PUBLIC_URL=http://127.0.0.1:8080

# Platform DB (sqlite local / postgres production)
PLATFORM_DATABASE_URL=sqlite+aiosqlite:///./data/platform.db
# PLATFORM_DATABASE_URL=postgresql+asyncpg://mafia:mafia_secret@postgres:5432/platform

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=mafia
POSTGRES_ADMIN_PASSWORD=mafia_secret
POSTGRES_ADMIN_DB=postgres

REDIS_URL=redis://127.0.0.1:6379/0

# python -c "import secrets; print(secrets.token_hex(32))"
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET_KEY=change-me-jwt-super-secret-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

ADMIN_TELEGRAM_IDS=123456789

SUBSCRIPTION_PRICE_STARS=300
SUBSCRIPTION_DAYS=30
GRACE_PERIOD_HOURS=24
DATA_RETENTION_DAYS=30
# false = test mode (no Stars payment)
PAYMENTS_ENABLED=false

# docker | process  (Windows/local: process; Ubuntu prod: docker)
DEPLOY_PROVIDER=process
MAFIA_IMAGE_NAME=mafia-bot-template:latest
TEMPLATE_PATH=./template/mafia-bot
DEPLOYMENTS_ROOT=./data/deployments
BACKUPS_ROOT=./data/backups
DOCKER_NETWORK=mafia_builder_net
PYTHON_EXECUTABLE=python

SUPPORT_URL=https://t.me/your_support
BRAND_NAME=True Mafia Builder
DEFAULT_LANGUAGE=uz
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8080
