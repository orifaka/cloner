# Builder bot (BotFather)
BUILDER_BOT_TOKEN=123456:REPLACE_ME
BUILDER_BOT_USERNAME=

# DB (sqlite — default, no postgres needed)
PLATFORM_DATABASE_URL=sqlite+aiosqlite:///./data/platform.db

# Security (min 32 chars)
# python3 -c "import secrets; print(secrets.token_hex(32))"
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admins (telegram user id, comma-separated)
ADMIN_TELEGRAM_IDS=

# Billing
SUBSCRIPTION_PRICE_STARS=300
SUBSCRIPTION_DAYS=30
GRACE_PERIOD_HOURS=24
# false = test (free deploy), true = Telegram Stars
PAYMENTS_ENABLED=false

# Paths
TEMPLATE_PATH=./template/mafia-bot
DEPLOYMENTS_ROOT=./data/deployments
BACKUPS_ROOT=./data/backups
PYTHON_EXECUTABLE=python3

# Brand
SUPPORT_URL=https://t.me
BRAND_NAME=True Mafia Builder
DEFAULT_LANGUAGE=uz
LOG_LEVEL=INFO
